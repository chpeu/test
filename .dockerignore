# .dockerignore - Fichiers à exclure du contexte Docker

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/
*.cover

# Documentation
docs/
*.md
!README.md

# Logs locaux (on utilisera des volumes)
logs/*.log
*.log

# Data locale (on utilisera des volumes)
data/*.db
data/*.json
trade_history.json
analytics.db

# Environnement
.env
.env.local
.env.*.local

# Backup
*.bak
*.backup
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Archives
*.zip
*.tar.gz
*.rar

# Autres
.cache/
tmp/
temp/
