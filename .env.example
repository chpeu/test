# PostgreSQL DataLogger Configuration
# Copier ce fichier vers .env et ajuster les valeurs

# ============================================
# ACTIVER LE DATALOGGER (IMPORTANT!)
# ============================================
# Par défaut le datalogger est DÉSACTIVÉ
# Mettez cette valeur à 'true' pour activer l'enregistrement dans PostgreSQL
POSTGRES_ENABLED=true

# ============================================
# PostgreSQL Connection
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_cursor_ml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=votre_mot_de_passe_ici
POSTGRES_USE_SSL=false

# ============================================
# Pool de connexions
# ============================================
POSTGRES_MIN_CONN=1
POSTGRES_MAX_CONN=5
